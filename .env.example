# =============================================================================
# RAG Configurator - Environment Variables
# Copy this file to .env and fill in your actual values
# =============================================================================

# =============================================================================
# General Settings
# =============================================================================

# Environment: development, staging, production
ENVIRONMENT=development

# Local data path - mount a folder from your host machine into Docker containers
# This lets you browse and select local folders for document ingestion
# Examples: C:\Users\yourname\Documents  or  /home/yourname/documents
LOCAL_DATA_PATH=.

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =============================================================================
# Database (MongoDB)
# =============================================================================

# MongoDB connection URI
# Development: mongodb://localhost:27017
# Production: mongodb://username:password@host:port/database?authSource=admin
MONGODB_URI=mongodb://localhost:27017

# MongoDB database name
MONGODB_DATABASE=rag_configurator

# MongoDB credentials (for production)
MONGODB_USERNAME=admin
MONGODB_PASSWORD=changeme-strong-password

# =============================================================================
# Cache & Queue (Redis)
# =============================================================================

# Redis connection URL
# Development: redis://localhost:6379/0
# Production: redis://:password@host:port/0
REDIS_URL=redis://localhost:6379/0

# Redis password (for production)
REDIS_PASSWORD=changeme-strong-password

# Celery broker URL (usually same as Redis)
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend (usually same as Redis)
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# Authentication (JWT)
# =============================================================================

# JWT secret key - MUST be changed in production!
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32

# JWT algorithm (default: HS256)
JWT_ALGORITHM=HS256

# Access token expiration (minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiration (days)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# Backend Services URLs
# =============================================================================

# Config Service URL
CONFIG_SERVICE_URL=http://localhost:8001

# Ingestion Service URL
INGESTION_SERVICE_URL=http://localhost:8002

# RAG Service URL
RAG_SERVICE_URL=http://localhost:8003

# =============================================================================
# Gateway Settings
# =============================================================================

# Gateway port
GATEWAY_PORT=8000

# CORS allowed origins (comma-separated)
# Development: http://localhost:3000,http://localhost:3001,http://localhost:5173
# Production: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting - requests per second
RATE_LIMIT_RPS=100

# Rate limiting - burst capacity
RATE_LIMIT_BURST=200

# =============================================================================
# Service Ports (for development)
# =============================================================================

# Config Service port
CONFIG_SERVICE_PORT=8001

# Ingestion Service port
INGESTION_SERVICE_PORT=8002

# RAG Service port
RAG_SERVICE_PORT=8003

# =============================================================================
# External API Keys (Optional)
# =============================================================================

# OpenAI API key - required for OpenAI embeddings and LLM
OPENAI_API_KEY=sk-...

# Anthropic API key - required for Anthropic Claude LLM
ANTHROPIC_API_KEY=sk-ant-...

# TypeSafe Jev (System One) — used by the Jev-as-a-judge evaluator
# Never commit a real key. Docs: docs/jev-eval.md
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest
JEV_EVAL_REPEATS=10
JEV_EVAL_USD_CAP=2.0
JEV_EVAL_LIVE=0

# Ollama Cloud (OpenAI-compatible) — live LLM-as-judge baseline for Jev compare.
# Hermes uses this path, not OpenAI/Anthropic direct.
# Chat completions: https://ollama.com/v1  (NOT https://ollama.com/api/v1)
OLLAMA_API_KEY=
# Optional OpenAI-compat override. When the key is set, local :11434 is ignored
# for the live judge and the default base is https://ollama.com/v1
# OLLAMA_OPENAI_BASE_URL=https://ollama.com/v1
# JEV_EVAL_LLM_BASE_URL=https://ollama.com/v1
# JEV_EVAL_LLM_MODEL=gpt-oss:20b

# Ollama native base URL — local /api/chat (no auth). Keep for local models.
# Example: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# vLLM base URL - for vLLM hosting
# Example: http://localhost:8080
VLLM_BASE_URL=http://localhost:8080

# =============================================================================
# MLflow (Optional - for prompt tracking)
# =============================================================================

# MLflow tracking server URL
MLFLOW_TRACKING_URI=http://localhost:5000

# =============================================================================
# Docker & Deployment
# =============================================================================

# Docker registry URL (without trailing slash)
# Example: ghcr.io/yourusername or docker.io/yourusername
DOCKER_REGISTRY=ghcr.io/yourusername

# Docker image tag (default: latest)
IMAGE_TAG=latest

# =============================================================================
# SSL/TLS (Production)
# =============================================================================

# Path to SSL certificate (inside container)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem

# Path to SSL private key (inside container)
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Path to SSL certificate chain (inside container)
SSL_CHAIN_PATH=/etc/nginx/ssl/chain.pem

# =============================================================================
# Monitoring & Observability (Optional)
# =============================================================================

# Enable metrics collection (true/false)
ENABLE_METRICS=false

# Prometheus metrics port
METRICS_PORT=9090

# Jaeger tracing endpoint (optional)
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# =============================================================================
# Security Settings (Production)
# =============================================================================

# Enable HTTPS only (true/false)
FORCE_HTTPS=false

# HSTS max age in seconds (default: 31536000 = 1 year)
HSTS_MAX_AGE=31536000

# Content Security Policy (CSP) - customize as needed
# CSP_DIRECTIVES=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline';

# =============================================================================
# Feature Flags
# =============================================================================

# Enable graph-based retrieval
ENABLE_GRAPH_RETRIEVAL=true

# Enable streaming responses
ENABLE_STREAMING=true

# Enable WebSocket connections
ENABLE_WEBSOCKET=true

# =============================================================================
# Development Only
# =============================================================================

# Enable hot reload for Python services
PYTHON_RELOAD=true

# Enable debug mode (shows detailed error messages)
DEBUG=false

# Node environment for UI builds
NODE_ENV=development

# =============================================================================
# Notes
# =============================================================================

# 1. Never commit .env file with real credentials to version control
# 2. In production, use Docker secrets or a secrets manager
# 3. Rotate JWT_SECRET_KEY and API keys regularly
# 4. Use strong passwords for MongoDB and Redis
# 5. Enable SSL/TLS in production
# 6. Set DEBUG=false in production
# 7. Use different JWT_SECRET_KEY for each environment
